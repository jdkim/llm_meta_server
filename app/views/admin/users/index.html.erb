<% content_for :title, "Users · Admin" %>
<div class="max-w-5xl mx-auto px-4 py-6">
  <%= render "admin/nav" %>
  <h2 class="text-2xl font-bold text-gray-900 mb-1">Users</h2>
  <p class="text-sm text-gray-600 mb-5">
    super_user comes from the <code>SUPER_USER_EMAILS</code> env allowlist, so it is shown
    here but changed on the host — a restart is required for it to take effect.
  </p>

  <div class="bg-white shadow-sm border border-gray-200 rounded-md p-4">
    <table class="min-w-full text-sm">
      <thead class="text-left text-gray-500">
        <tr>
          <th class="py-1 pr-3">Email</th><th class="py-1 pr-3">Role</th>
          <th class="py-1 pr-3">API keys</th><th class="py-1 pr-3">MCP servers</th>
          <th class="py-1 pr-3">Balance</th><th class="py-1">Joined</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |u| %>
          <tr class="border-t border-gray-100">
            <td class="py-1.5 pr-3 text-gray-900"><%= u.email %></td>
            <td class="py-1.5 pr-3">
              <% if @super_user_emails.include?(u.email.to_s.downcase) %>
                <span class="text-xs bg-blue-100 text-blue-800 px-1.5 rounded">super_user</span>
              <% else %>
                <span class="text-xs text-gray-500">user</span>
              <% end %>
            </td>
            <td class="py-1.5 pr-3 text-xs text-gray-600"><%= u.llm_api_keys.size %></td>
            <td class="py-1.5 pr-3 text-xs text-gray-600"><%= u.mcp_servers.size %></td>
            <td class="py-1.5 pr-3 text-xs text-gray-600"><%= number_to_currency(u.current_balance_cents / 100.0) %></td>
            <td class="py-1.5 text-xs text-gray-500"><%= u.created_at.strftime("%Y-%m-%d") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
