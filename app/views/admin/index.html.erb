<% content_for :title, "Admin · hub.AIbranch" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <div class="flex justify-between items-center">
    <%= render "admin/nav" %>
    <h2 class="text-2xl font-bold text-gray-900">Hub Admin Dashboard</h2>
    <span class="text-xs text-gray-500">Snapshot: <%= @stats[:generated_at] %></span>
  </div>

  <%# Top-line counters %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <% [
      [ "Users",           @stats.dig(:users, :total) ],
      [ "With API keys",   @stats.dig(:users, :with_api_keys) ],
      [ "API keys total",  @stats.dig(:llm_api_keys, :total) ],
      [ "MCP servers",     @stats.dig(:mcp, :servers_total) ]
    ].each do |label, value| %>
      <div class="bg-white shadow-sm border border-gray-200 rounded-md p-4">
        <div class="text-xs text-gray-500 uppercase tracking-wide"><%= label %></div>
        <div class="text-2xl font-semibold text-gray-900 mt-1"><%= value %></div>
      </div>
    <% end %>
  </div>

  <%# API keys by provider %>
  <div class="bg-white shadow-sm border border-gray-200 rounded-md p-4">
    <h3 class="text-sm font-semibold text-gray-700 mb-3">API keys by provider</h3>
    <table class="min-w-full text-sm">
      <thead class="text-left text-gray-500">
        <tr><th class="py-1 pr-4">Provider</th><th class="py-1">Count</th></tr>
      </thead>
      <tbody>
        <% @stats.dig(:llm_api_keys, :by_provider).sort_by { |_, n| -n }.each do |provider, n| %>
          <tr class="border-t border-gray-100">
            <td class="py-1 pr-4"><%= provider %></td>
            <td class="py-1"><%= n %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# MCP breakdown %>
  <div class="bg-white shadow-sm border border-gray-200 rounded-md p-4">
    <h3 class="text-sm font-semibold text-gray-700 mb-3">MCP servers + tools</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <% [
        [ "Servers total",  @stats.dig(:mcp, :servers_total) ],
        [ "Public servers", @stats.dig(:mcp, :servers_public) ],
        [ "Active servers", @stats.dig(:mcp, :servers_active) ],
        [ "Tools total",    @stats.dig(:mcp, :tools_total) ],
        [ "Tools active",   @stats.dig(:mcp, :tools_active) ]
      ].each do |label, value| %>
        <div>
          <div class="text-xs text-gray-500"><%= label %></div>
          <div class="text-lg font-medium text-gray-900"><%= value %></div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Top favorited models %>
  <div class="bg-white shadow-sm border border-gray-200 rounded-md p-4">
    <h3 class="text-sm font-semibold text-gray-700 mb-3">Top favorited models</h3>
    <% top = @stats.dig(:favorites, :top_favorited_models) %>
    <% if top.blank? %>
      <p class="text-sm text-gray-500">No favorites yet.</p>
    <% else %>
      <table class="min-w-full text-sm">
        <thead class="text-left text-gray-500">
          <tr><th class="py-1 pr-4">Model</th><th class="py-1">Users</th></tr>
        </thead>
        <tbody>
          <% top.each do |model, n| %>
            <tr class="border-t border-gray-100">
              <td class="py-1 pr-4"><code><%= model %></code></td>
              <td class="py-1"><%= n %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%# Recent signups %>
  <div class="bg-white shadow-sm border border-gray-200 rounded-md p-4">
    <h3 class="text-sm font-semibold text-gray-700 mb-3">
      Recent signups
      <span class="text-xs text-gray-500 font-normal">— <%= @stats.dig(:users, :recent_signups_7d) %> in the last 7 days</span>
    </h3>
    <table class="min-w-full text-sm">
      <thead class="text-left text-gray-500">
        <tr><th class="py-1 pr-4">Email</th><th class="py-1">Joined</th></tr>
      </thead>
      <tbody>
        <% @stats.dig(:users, :recent).each do |email, joined_at| %>
          <tr class="border-t border-gray-100">
            <td class="py-1 pr-4"><%= email %></td>
            <td class="py-1 text-gray-600"><%= joined_at.strftime("%Y-%m-%d %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="bg-white shadow-sm border border-gray-200 rounded-md p-4">
    <h3 class="text-sm font-semibold text-gray-700 mb-3">
      Model catalog
      <span class="text-xs text-gray-500 font-normal">
        — <%= @stats.dig(:catalog, :models_total) %> models
        (<%= @stats.dig(:catalog, :models_by_provider).map { |p, n| "#{p} #{n}" }.join(", ") %>)
      </span>
    </h3>

    <% errors = @stats.dig(:catalog, :validation_errors).to_i %>
    <% due    = @stats.dig(:catalog, :pricing_review_due).to_i %>
    <div class="flex flex-wrap gap-2 mb-3">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= errors.zero? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
        <%= errors.zero? ? "catalog valid" : "#{errors} validation error(s)" %>
      </span>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= due.zero? ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>"
            title="Pricing not reviewed within <%= ModelCatalogValidator::STALE_AFTER_DAYS %> days">
        <%= due.zero? ? "pricing current" : "#{due} pricing review(s) due" %>
      </span>
    </div>

    <% if due.positive? %>
      <p class="text-xs text-gray-600 mb-3">
        Due: <%= @stats.dig(:catalog, :pricing_review_models).join(", ") %><br>
        Run <code>bin/rails models:review_pricing</code> for the pricing pages and the confirm command.
      </p>
    <% end %>

    <h4 class="text-xs font-semibold text-gray-600 mb-1">Last provider check</h4>
    <% checks = @stats.dig(:catalog, :provider_checks) || [] %>
    <% if checks.empty? %>
      <p class="text-xs text-gray-500">
        Never run. <code>bin/rails models:check_updates</code> compares the catalog against each
        provider's live model list (it uses the stored provider keys — no setup needed).
      </p>
    <% else %>
      <table class="min-w-full text-sm">
        <thead class="text-left text-gray-500">
          <tr><th class="py-1 pr-4">Provider</th><th class="py-1 pr-4">Checked</th><th class="py-1">Result</th></tr>
        </thead>
        <tbody>
          <% checks.each do |c| %>
            <tr class="border-t border-gray-100">
              <td class="py-1 pr-4"><%= c[:provider] %></td>
              <td class="py-1 pr-4 text-gray-600"><%= c[:days_ago] %>d ago</td>
              <td class="py-1">
                <% if c[:error].present? %>
                  <span class="text-red-700"><%= c[:error] %></span>
                <% elsif c[:new_in_provider].any? || c[:missing_from_provider].any? %>
                  <% if c[:new_in_provider].any? %>
                    <span class="text-amber-700">new: <%= c[:new_in_provider].join(", ") %></span><br>
                  <% end %>
                  <% if c[:missing_from_provider].any? %>
                    <span class="text-gray-600">missing: <%= c[:missing_from_provider].join(", ") %></span>
                  <% end %>
                <% else %>
                  <span class="text-green-700">up to date</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
